# Server variables only. Never prefix a secret with VITE_.
# Keep the real file OUTSIDE Apache's document root:
# Windows: %LOCALAPPDATA%/TerraLens/server.env
# Linux/macOS: ~/.config/terralens/server.env
# Or set these directly in the server process environment.
GEMINI_API_KEY=replace_with_your_server_key
GEMINI_MODEL=gemini-3.1-flash-lite
HOST=127.0.0.1
PORT=8787
# Set to the exact public origin when running behind a reverse proxy.
# ALLOWED_ORIGIN=https://terralens.example
# TERRALENS_ENV_FILE=/private/path/server.env
